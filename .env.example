# Set existing-project values privately in .env.local or Vercel environment settings.
# Never paste real credentials into chat, commit them, or prefix server secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
RATE_LIMIT_SALT=
NEXT_PUBLIC_SITE_URL=https://healingmuse.vercel.app
LOCAL_CATALOG_ENABLED=false

# Trusted local database tools only. Do not deploy the database connection string.
SUPABASE_DB_URL=
SUPABASE_DB_CA_FILE=.local/supabase-ca.crt

# Set only after verifying actual available project capacity and existing usage.
SUPABASE_STORAGE_AVAILABLE_BYTES=0
