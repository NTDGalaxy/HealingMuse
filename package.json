{
  "name": "healingmuse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "build:preview": "node scripts/preview.mjs --build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "audio:import": "node scripts/import-audio.mjs",
    "audio:verify": "node scripts/verify-audio.mjs",
    "audio:audit": "node scripts/audit-recording-identity.mjs",
    "audio:classify": "node scripts/classify-publisher.mjs",
    "audio:quarantine": "node scripts/quarantine-audio.mjs",
    "test:load": "node scripts/load-test.mjs",
    "db:test": "node scripts/test-database.mjs",
    "db:test:cloud": "node scripts/test-cloud-database.mjs",
    "prebuild": "node scripts/build-shell.mjs",
    "audio:upload": "node scripts/upload-audio.mjs",
    "test:sync-load": "node scripts/sync-load-test.mjs",
    "test:live-access": "node scripts/live-access-test.mjs",
    "security:client": "node scripts/check-client-secrets.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:certificate": "node scripts/download-database-ca.mjs",
    "cloud:verify": "node scripts/verify-cloud.mjs",
    "test:recovery": "node scripts/recovery-check.mjs",
    "dev:preview": "node scripts/preview.mjs",
    "start:preview": "node scripts/preview.mjs --production",
    "audio:discover": "node scripts/discover-incompetech.mjs && node scripts/discover-audio.mjs",
    "db:test:catalog": "node scripts/test-catalog-database.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:register": "node scripts/prepare-release.mjs --register",
    "db:test:release": "node scripts/test-release-database.mjs",
    "release:verify:cloud": "node scripts/verify-release-cloud.mjs",
    "content:admin": "node scripts/content-admin.mjs",
    "test:performance": "node scripts/measure-browser.mjs",
    "b2:preflight": "node scripts/b2-audio.mjs preflight",
    "b2:upload": "node scripts/b2-audio.mjs upload",
    "b2:verify": "node scripts/b2-audio.mjs verify",
    "db:test:b2": "node scripts/test-b2-database.mjs",
    "security:repository": "node scripts/check-repository-secrets.mjs",
    "b2:account": "node scripts/b2-account-confirm.mjs",
    "release:register:b2": "node scripts/prepare-release.mjs --register --provider=b2",
    "b2:connection": "node scripts/b2-connection.mjs",
    "b2:test:preflight": "node scripts/test-b2-preflight.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dotenv": "18.0.6",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "ffmpeg-static": "5.3.0",
    "pg": "8.23.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
